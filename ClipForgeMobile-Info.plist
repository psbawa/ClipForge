<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_clipforge._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ClipForge connects to the ClipForge app on your Mac over your Wi-Fi to show and review your clips.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>ClipForge saves clips you choose to your Photos.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
